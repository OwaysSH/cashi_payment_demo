<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain HTTP is allowed to local development hosts (backend :8080 and Firestore
  emulator :8085), and nowhere else.
  - 127.0.0.1 / localhost: real device via `adb reverse` (scripts/device-setup.sh)
  - 10.0.2.2: Android emulator's alias for the host machine
  To use a LAN IP override (api.baseUrl in local.properties), add it here as another <domain>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>