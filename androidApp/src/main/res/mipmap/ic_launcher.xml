<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for API 24–25 (no adaptive icons): the same vectors, in a rounded square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00696B" />
            <corners android:radius="@dimen/legacy_launcher_corner_radius" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>