<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon glyph: a bold coin with a send arrow, in white, within the adaptive icon's 66dp
  safe zone. The arrow is cut out of the coin (evenOdd), so the glyph is a single color and also
  serves as the monochrome (themed icon) layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Coin rim: radius 30 around the center. -->
    <path
        android:pathData="M54,24a30,30 0,1 1,0 60a30,30 0,1 1,0 -60z"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFF" />
    <!-- Coin face (radius 26) with a right arrow cut out, turned to point up and to the right. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M54,28a26,26 0,1 1,0 52a26,26 0,1 1,0 -52z M38,49.5L54,49.5L54,40L70,54L54,68L54,58.5L38,58.5z" />
    </group>
</vector>